{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "timestamp",
    "producer_repository",
    "release_tag",
    "source_commit",
    "release_id",
    "workflow_run",
    "failed_stage",
    "error_code",
    "error_message",
    "expected",
    "received",
    "remediation_hint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "result": {"enum": ["accepted", "rejected"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "producer_repository": {"type": ["string", "null"]},
    "release_tag": {"type": ["string", "null"]},
    "source_commit": {"type": ["string", "null"]},
    "release_id": {"type": ["integer", "string", "null"]},
    "workflow_run": {"type": ["integer", "string", "null"]},
    "failed_stage": {"type": ["string", "null"]},
    "error_code": {
      "type": ["string", "null"],
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "error_message": {"type": ["string", "null"]},
    "expected": {
      "type": ["string", "integer", "boolean", "array", "null"],
      "items": {"type": ["string", "integer", "boolean", "null"]}
    },
    "received": {
      "type": ["string", "integer", "boolean", "array", "null"],
      "items": {"type": ["string", "integer", "boolean", "null"]}
    },
    "remediation_hint": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "accepted"}}},
      "then": {
        "properties": {
          "failed_stage": {"type": "null"},
          "error_code": {"type": "null"},
          "error_message": {"type": "null"},
          "expected": {"type": "null"},
          "received": {"type": "null"},
          "remediation_hint": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "failed_stage": {"type": "string", "minLength": 1},
          "error_code": {"type": "string", "minLength": 1},
          "error_message": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
