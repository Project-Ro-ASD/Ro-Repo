{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signed_at",
    "workflow_run",
    "acceptance_manifest_digest",
    "rpm_signing_fingerprint",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "signed_at": {"type": "string", "format": "date-time"},
    "workflow_run": {"type": "integer", "minimum": 1},
    "acceptance_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rpm_signing_fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "architecture",
        "nevra",
        "producer_artifact_sha256",
        "signed_artifact_sha256"
      ],
      "properties": {
        "filename": {"type": "string", "pattern": "^[^/]+\\.rpm$"},
        "architecture": {"type": "string", "minLength": 1},
        "nevra": {"type": "string", "minLength": 1},
        "producer_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signed_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
