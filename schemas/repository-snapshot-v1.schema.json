{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "created_at",
    "fedora_release",
    "parent_snapshot",
    "packages",
    "repositories",
    "rpm_signing_fingerprint",
    "metadata_signing_fingerprint",
    "creation_provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "snapshot_id": { "type": "string", "pattern": "^repo-f44-[0-9]{8}-[0-9]{3}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "fedora_release": { "const": 44 },
    "parent_snapshot": { "type": ["string", "null"], "pattern": "^repo-f44-[0-9]{8}-[0-9]{3}$" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/package" }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x86_64", "aarch64", "source"],
      "properties": {
        "x86_64": { "$ref": "#/$defs/repository" },
        "aarch64": { "$ref": "#/$defs/repository" },
        "source": { "$ref": "#/$defs/repository" }
      }
    },
    "rpm_signing_fingerprint": { "type": "string", "pattern": "^[A-F0-9]{40,64}$" },
    "metadata_signing_fingerprint": { "type": "string", "pattern": "^[A-F0-9]{40,64}$" },
    "creation_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "run"],
      "properties": {
        "tool": { "const": "ro-repo-v2" },
        "run": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nevra",
        "architecture",
        "filename",
        "producer_artifact_sha256",
        "published_signed_artifact_sha256",
        "producer_manifest_digest"
      ],
      "properties": {
        "nevra": { "type": "string", "minLength": 1 },
        "architecture": { "enum": ["x86_64", "aarch64", "noarch", "src", "nosrc"] },
        "filename": { "type": "string", "pattern": "^[^/]+\\.rpm$" },
        "producer_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "published_signed_artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "producer_manifest_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repomd_sha256", "repomd_signature_sha256"],
      "properties": {
        "repomd_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repomd_signature_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
