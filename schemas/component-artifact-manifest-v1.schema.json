{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","component","source_repository","source_commit","release_tag","release_id","workflow_run","fedora_release","artifacts","provenance","attestation"],"properties":{"schema_version":{"const":1},"component":{"type":"string","minLength":1},"source_repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"release_tag":{"type":"string","minLength":2},"release_id":{"type":["integer","string"]},"workflow_run":{"type":["integer","string"]},"fedora_release":{"const":44},"artifacts":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/artifact"}},"provenance":{"type":"object","required":["provider","subject_digest"],"additionalProperties":true},"attestation":{"type":"object","required":["provider","verification"],"additionalProperties":true},"sbom":{"type":["object","null"]}},"$defs":{"artifact":{"type":"object","additionalProperties":false,"required":["filename","name","epoch","version","release","architecture","source_rpm","producer_artifact_sha256"],"properties":{"filename":{"type":"string","pattern":"^[^/]+\\.rpm$"},"name":{"type":"string"},"epoch":{"type":"integer","minimum":0},"version":{"type":"string"},"release":{"type":"string"},"architecture":{"enum":["x86_64","aarch64","noarch","src","nosrc"]},"source_rpm":{"type":["string","null"]},"producer_artifact_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}}
