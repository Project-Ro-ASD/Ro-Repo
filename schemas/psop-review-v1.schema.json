{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "context",
    "profile",
    "source_pins",
    "inputs_sha256",
    "history_sha256",
    "genesis_sha256",
    "previous_stable_sha256",
    "policy_version",
    "policy_sha256",
    "plan_sha256",
    "evidence_sha256",
    "result_sha256",
    "publishable"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "psop-review-test-1"
    },
    "context": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
      "const": "psop-pages-stable"
    },
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_sha",
        "pages_sha"
      ],
      "properties": {
        "main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pages_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "inputs_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "history_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "genesis_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_stable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publishable": {
      "const": false
    }
  }
}
