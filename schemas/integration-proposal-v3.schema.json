{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integration-proposal-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "candidate_sha256",
    "artifact_set_sha256",
    "candidate_identity",
    "promotion_group",
    "mode",
    "reason",
    "policy_version",
    "policy_sha256",
    "previous_stable_snapshot_id",
    "previous_stable_sha256",
    "result_stable_sha256",
    "stable_set_sha256",
    "first_seen",
    "dwell_met",
    "minimum_beta_days",
    "evidence_sha256",
    "approval_granted",
    "publishable",
    "proposal_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "scope": {
      "const": "v3-integrated-proposal-untrusted"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_group",
        "fedora_release",
        "policy",
        "packages",
        "source_provenance"
      ],
      "properties": {
        "promotion_group": {
          "type": "string",
          "minLength": 1
        },
        "fedora_release": {
          "const": 44
        },
        "policy": {
          "type": "object"
        },
        "packages": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nevra",
              "architecture",
              "filename",
              "producer_artifact_sha256",
              "published_signed_artifact_sha256",
              "producer_manifest_digest"
            ],
            "properties": {
              "nevra": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "enum": [
                  "x86_64",
                  "aarch64",
                  "noarch",
                  "src",
                  "nosrc"
                ]
              },
              "filename": {
                "type": "string",
                "pattern": "^[^/]+\\.rpm$"
              },
              "producer_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "published_signed_artifact_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer_manifest_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "source_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "promotion_group": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "normal",
        "fast-track"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_stable_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^repo-f44-[0-9]{8}-[0-9]{3}$"
    },
    "previous_stable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_stable_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stable_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "first_seen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_at",
        "publication_run"
      ],
      "properties": {
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "publication_run": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "dwell_met": {
      "type": "boolean"
    },
    "minimum_beta_days": {
      "enum": [
        7,
        14
      ]
    },
    "evidence_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "approval_granted": {
      "const": false
    },
    "publishable": {
      "const": false
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
