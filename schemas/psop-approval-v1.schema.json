{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "domain",
    "review",
    "identity",
    "attempt",
    "nonce",
    "writer",
    "expected_git",
    "metadata_key",
    "publishable",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "const": "psop-approval-test-1"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "context",
        "profile",
        "source_pins",
        "inputs_sha256",
        "history_sha256",
        "genesis_sha256",
        "previous_stable_sha256",
        "policy_version",
        "policy_sha256",
        "plan_sha256",
        "evidence_sha256",
        "result_sha256",
        "publishable"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "domain": {
          "const": "psop-review-test-1"
        },
        "context": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "const": "psop-pages-stable"
        },
        "source_pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "main_sha",
            "pages_sha"
          ],
          "properties": {
            "main_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "pages_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        },
        "inputs_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "genesis_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_stable_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "publishable": {
          "const": false
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "repository",
        "actor",
        "run_id",
        "run_attempt"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_attempt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attempt": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "writer": {
      "enum": [
        "psop-stable",
        "v2-snapshot",
        "v2-beta",
        "v2-rollback",
        "v2-stable"
      ]
    },
    "expected_git": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "metadata_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "fingerprint"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[A-F0-9]{40}$"
        }
      }
    },
    "publishable": {
      "const": false
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1
    }
  }
}
